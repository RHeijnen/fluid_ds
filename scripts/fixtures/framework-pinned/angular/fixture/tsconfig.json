{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "paths": {
      "@fluid-ds/components": ["./node_modules/@fluid-ds/components/dist/index.js"],
      "@fluid-ds/components/define/*": [
        "./node_modules/@fluid-ds/components/dist/components/*/define.js"
      ],
      "@fluid-ds/components/internal/*": ["./node_modules/@fluid-ds/components/dist/internal/*.js"],
      "@fluid-ds/charts": ["./node_modules/@fluid-ds/charts/dist/index.js"],
      "@fluid-ds/charts/define/*": ["./node_modules/@fluid-ds/charts/dist/components/*/define.js"],
      "@fluid-ds/icons": ["./node_modules/@fluid-ds/icons/dist/index.js"],
      "@fluid-ds/icons/registry": ["./node_modules/@fluid-ds/icons/dist/registry.js"],
      "@fluid-ds/icons/register-defaults": [
        "./node_modules/@fluid-ds/icons/dist/register-defaults.js"
      ],
      "@fluid-ds/icons/lucide/*": ["./node_modules/@fluid-ds/icons/dist/lucide/*.js"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  }
}
