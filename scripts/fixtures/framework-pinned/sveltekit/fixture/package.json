{
  "name": "@fluid-ds/framework-sveltekit-packed-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Executable SvelteKit consumer contract for Fluid.",
  "scripts": {
    "build": "vite build",
