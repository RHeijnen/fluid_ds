{
  "name": "@fluid-ds/framework-vue-packed-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Executable Vue 3 consumer contract for Fluid.",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fluid-ds/components": "file:../packs/fluid-ds-components-0.4.0.tgz",
    "@fluid-ds/tokens": "file:../packs/fluid-ds-tokens-0.4.0.tgz",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@fluid-ds/components@0.4.0>@fluid-ds/icons": "file:../packs/fluid-ds-icons-0.4.0.tgz",
      "@fluid-ds/components@0.4.0>@fluid-ds/tokens": "file:../packs/fluid-ds-tokens-0.4.0.tgz"
    }
  }
