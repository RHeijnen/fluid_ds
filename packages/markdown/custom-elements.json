      "declarations": [
        {
          "kind": "class",
          "description": "Renders Markdown to HTML inside the shadow DOM. Provide source in one\nof three ways:\n\n  - inline text content (the default slot)\n  - the `value` property\n  - a remote URL via the `src` attribute\n\nPowered by [marked](https://marked.js.org/). Pass `marked` options via\nthe `options` property if you need GFM, breaks, etc.\n\nRendered HTML is sanitized with DOMPurify by default since `marked` does not\nsanitize and `src` can fetch untrusted remote content. Set `trusted` to\nbypass sanitization for known-safe input.",
          "name": "FluidMarkdown",
          "cssProperties": [
            {
              "description": "Text color.",
              "name": "--fluid-markdown-color"
            },
            {
              "description": "Background for inline and block code.",
              "name": "--fluid-markdown-code-bg"
            },
            {
              "description": "Blockquote left border color.",
              "name": "--fluid-markdown-blockquote-border"
            },
            {
              "description": "Blockquote text color.",
              "name": "--fluid-markdown-blockquote-fg"
            },
            {
              "description": "Link color.",
              "name": "--fluid-markdown-link-fg"
            },
            {
              "description": "Table cell border color.",
              "name": "--fluid-markdown-table-border"
            }
          ],
          "cssParts": [
            {
              "description": "The rendered output container.",
              "name": "base"
            }
          ],
          "slots": [
            {
              "description": "Markdown source as a text node.",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "value",
              "type": {
                "text": "string | null"
              },
              "default": "null",
              "description": "Markdown source.",
              "attribute": "value"
            },
            {
              "kind": "field",
              "name": "src",
              "type": {
                "text": "string | null"
              },
              "default": "null",
              "description": "Fetch source from this URL.",
              "attribute": "src"
            },
            {
              "kind": "field",
              "name": "options",
              "type": {
                "text": "MarkedOptions"
              },
              "default": "{ gfm: true, breaks: false }",
              "description": "Pass-through options for marked."
            },
            {
              "kind": "field",
              "name": "trusted",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Skip HTML sanitization. Only set this when the markdown source is fully\ntrusted: it allows raw script/iframe/event-handler markup to execute.",
              "attribute": "trusted"
            },
            {
              "kind": "field",
              "name": "rendered",
