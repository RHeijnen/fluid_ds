        {
          "kind": "class",
          "description": "A themed Leaflet map. Renders an interactive tile map with optional markers,\ndriven by plain properties so it works from any framework.\n\nLeaflet needs its global stylesheet and a sized container, neither of which\nsurvive inside shadow DOM, so this component renders in LIGHT DOM (it\noverrides `createRenderRoot` to return itself). Leaflet's stylesheet is\nauto-loaded once from the CDN at runtime (a `<link>` appended to the document\nhead), so no bundler CSS handling is required. Consumers MUST have `leaflet`\ninstalled as a dependency. To self-host the CSS instead, add your own Leaflet\nstylesheet `<link>` (or one carrying `data-fluid-map-leaflet-css`) to the page\nbefore the component upgrades, and this auto-load is skipped.\n\nThe container is exposed as a labelled `role=\"region\"` so assistive tech can\nskip into and out of the interactive map. Provide a meaningful `label`.",
          "name": "FluidMap",
          "cssProperties": [
            {
              "description": "Map height. Falls back to 24rem.",
              "name": "--fluid-map-height"
            },
            {
              "description": "Corner radius of the viewport. Falls back to --fluid-radius-md.",
              "name": "--fluid-map-radius"
            },
            {
              "description": "Border around the viewport. Falls back to 1px solid --fluid-border-default.",
              "name": "--fluid-map-border"
            }
          ],
          "cssParts": [
