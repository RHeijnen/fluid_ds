              "description": "Calendar text color. Falls back to --fluid-text-primary.",
              "name": "--fluid-event-calendar-fg"
            },
            {
              "description": "Muted text (trailing days, weekday heads). Falls back to --fluid-text-secondary.",
              "name": "--fluid-event-calendar-muted-fg"
