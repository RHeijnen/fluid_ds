{
  "name": "@fluid-ds/components",
  "version": "0.4.0",
  "description": "Framework-agnostic web components for Fluid: 124 standard custom elements in 103 component families. For HTML, React, Vue, Angular, Svelte and Solid.",
  "type": "module",
  "license": "MIT",
  "author": "Fluid contributors",
  "homepage": "https://github.com/RHeijnen/fluid_ds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RHeijnen/fluid_ds.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/RHeijnen/fluid_ds/issues"
  },
  "keywords": [
    "fluid-ds",
    "design-system",
    "web-components",
    "custom-elements",
    "lit",
    "framework-agnostic",
    "accessible",
    "themable",
    "typescript",
    "components"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts"
    },
    "./define/*": {
      "types": "./src/components/*/define.ts",
      "node": "./dist/components/*/define.js",
      "import": "./src/components/*/define.ts"
    },
    "./internal/*": {
      "types": "./src/internal/*.ts",
      "node": "./dist/internal/*.js",
      "import": "./src/internal/*.ts"
    },
    "./ssr-client": {
      "types": "./src/ssr-client.ts",
      "import": "./src/ssr-client.ts"
    },
    "./ssr": {
      "types": "./src/ssr.ts",
      "import": "./src/ssr.ts"
    },
    "./locales/*": {
      "types": "./src/locales/*.ts",
      "import": "./src/locales/*.ts"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./define/*": {
        "types": "./dist/components/*/define.d.ts",
        "import": "./dist/components/*/define.js"
      },
      "./internal/*": {
        "types": "./dist/internal/*.d.ts",
        "import": "./dist/internal/*.js"
      },
      "./ssr-client": {
        "types": "./dist/ssr-client.d.ts",
        "import": "./dist/ssr-client.js"
      },
      "./ssr": {
        "types": "./dist/ssr.d.ts",
        "import": "./dist/ssr.js"
      },
      "./locales/*": {
        "types": "./dist/locales/*.d.ts",
        "import": "./dist/locales/*.js"
      },
      "./custom-elements.json": "./custom-elements.json"
    }
  },
  "files": [
    "dist",
    "src",
    "custom-elements.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./src/ssr-client.ts",
    "./dist/ssr-client.js",
    "**/define.js",
    "**/define.ts",
    "**/locales/*.js",
    "**/locales/*.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm analyze",
    "analyze": "node ../../scripts/cem/generate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-web-tests.mjs --config web-test-runner.config.js",
    "test:watch": "web-test-runner --config web-test-runner.config.js --watch",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@fluid-ds/icons": "workspace:*",
    "@fluid-ds/tokens": "workspace:*",
    "parse5": "^7.3.0"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@open-wc/testing": "^4.0.0",
    "@storybook/web-components": "^8.4.7",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "playwright": "^1.49.1",
    "lit": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
