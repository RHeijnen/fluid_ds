        {
          "kind": "class",
          "description": "A lightweight, accessible WYSIWYG rich-text editor. A roving-tabindex toolbar\n(role=\"toolbar\") of toggle buttons sits above a `contenteditable` region\nexposed as a multi-line textbox. Formatting uses `document.execCommand`, which\nis deprecated yet still universally supported and adequate for a small editor;\nno external editor library is pulled in.\n\nThe editable region takes its accessible name from the `label` prop and shows\nthe `placeholder` while empty. Get or set the HTML via the `value` property;\nsetting it replaces the editable content. Each input dispatches `fluid-change`\nwith the current HTML, and the toggle buttons reflect `aria-pressed` from\n`document.queryCommandState` whenever the selection changes.\nHorizontal toolbar arrows follow its rendered direction: Right advances in\nLTR and Left advances in RTL. Vertical arrows retain command-order semantics.",
          "name": "FluidRichTextEditor",
          "cssProperties": [
            {
              "description": "Editable region background. Falls back to --fluid-surface-base.",
              "name": "--fluid-editor-bg"
            },
            {
              "description": "Text color. Falls back to --fluid-text-primary.",
              "name": "--fluid-editor-fg"
            },
            {
              "description": "Border color. Falls back to --fluid-border-default.",
              "name": "--fluid-editor-border"
            },
            {
              "description": "Toolbar background. Falls back to --fluid-surface-muted.",
              "name": "--fluid-editor-toolbar-bg"
            },
            {
              "description": "Corner radius. Falls back to --fluid-radius-md.",
              "name": "--fluid-editor-radius"
            },
            {
              "description": "Focus ring color. Falls back to --fluid-accent-base.",
              "name": "--fluid-editor-focus"
            }
          ],
          "cssParts": [
