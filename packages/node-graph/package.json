{
  "name": "@fluid-ds/node-graph",
  "version": "0.4.0",
  "description": "Accessible node graph editor web component for Fluid (expansion pack): draggable nodes, connection ports and Bezier edges with full keyboard support.",
  "type": "module",
  "customElements": "custom-elements.json",
  "license": "MIT",
  "author": "Fluid contributors",
  "homepage": "https://github.com/RHeijnen/fluid_ds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RHeijnen/fluid_ds.git",
    "directory": "packages/node-graph"
  },
  "bugs": {
    "url": "https://github.com/RHeijnen/fluid_ds/issues"
  },
  "keywords": [
    "fluid-ds",
    "node-graph",
    "flow",
    "graph-editor",
    "workflow",
    "web-components",
    "design-system"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "exports": {
      "./custom-elements.json": "./custom-elements.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./define/*": {
        "types": "./dist/components/*/define.d.ts",
        "import": "./dist/components/*/define.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./custom-elements.json": "./custom-elements.json",
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts"
    },
    "./define/*": {
      "types": "./src/components/*/define.ts",
      "import": "./src/components/*/define.ts"
    }
  },
  "files": [
    "custom-elements.json",
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/define.js",
    "**/define.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-web-tests.mjs --config web-test-runner.config.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@fluid-ds/components": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@storybook/web-components": "^8.4.7",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "playwright": "^1.49.1",
    "lit": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
